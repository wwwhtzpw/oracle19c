<!DOCTYPE html>
<html lang="en">
    <head>
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        
        {{#if page.collections}}
		<!-- Inject CSS files -->
		<link rel="stylesheet" href="/sp_common/ohc-collection/css/collection.css" type="text/css" />
		<link rel="stylesheet" href="/sp_common/ohc-collection/css/redwood.css" type="text/css" />
		<link rel="stylesheet" href="/sp_common/ohc-collection/css/theme.css" type="text/css" />
		<!-- This contains icon fonts used by the starter template -->
		<link rel="stylesheet" id="uxiconFont"
			href="https://static.oracle.com/cdn/fnd/gallery/2404.0.0/images/iconfont/ojuxIconFont.min.css" />
		<!-- Load JavaScript files -->
		<script type="text/javascript" src="/sp_common/ohc-collection/requirejs/require.js"></script>
		<script type="text/javascript" src="/sp_common/ohc-collection/js/bundle.js"></script>
	
		{{else}}
        <link rel="stylesheet" href="/sp_common/site-template/ohc-site-template/css/site.css">
        
        <script data-main="/sp_common/site-template/ohc-site-template/js/site-config" src="/sp_common/site-template/requirejs/require.js"></script>
		<script>
        if(window.require === undefined) {
          document.write('<script data-main="sp_common/site-template/ohc-site-template/js/site-config" src="sp_common/site-template/requirejs/require.js"><\/script>');
          document.write('<link href="sp_common/site-template/ohc-site-template/css/site.css" rel="stylesheet">');
        }
        </script>
		{{/if}}
        <link rel="shortcut icon" href="/sp_common/site-template/ohc-common/img/favicon.ico">
        
        {{> headPartial}}

    </head>
	{{#if page.collections}}
	<body class="oj-web-applayout-body" data-oj-binding-provider="none">
        <noscript>
            <div>JavaScript must be enabled to correctly display this content</div>
        </noscript>
    
        {{> bodyPartial}}

    </body>
    {{else}}
	<body>
        <noscript>
            <div>JavaScript must be enabled to correctly display this content</div>
        </noscript>
    
        {{> bodyPartial}}

    </body>
	{{/if}}
</html>
