e_id":10386,"short_name":"not-applicable","element_name":"Not applicable","display_in_url":false},"product":{"node_id":10389,"short_name":"oracle-database","element_name":"Oracle Database","display_in_url":true},"release":{"node_id":38040,"short_name":"19","element_name":"Release 19","display_in_url":true}}],"book_direct_link_selectors":[{"infotype":"Get Started","title":"High Availability Reference Architectures","html_link":"https://docs.oracle.com/en/database/oracle/oracle-database/19/haiad/index.html"},{"infotype":"Get Started","title":"Oracle Maximum Availability Architecture Video Series","html_link":"https://www.youtube.com/playlist?list=PLcFwxJMrxygAutUzBPyPTA_voHObOo-jk"},{"infotype":"Get Started","title":"Real Applications Clusters Interactive Technical Architecture Diagram","html_link":"https://www.oracle.com/webfolder/technetwork/tutorials/architecture-diagrams/19/rac/main.html"}],"book_data":[{"title":"Autonomous Health Framework User’s Guide","description":"This book describes how to use Oracle Autonomous Health Framework diagnostic components - Oracle ORAchk, Cluster Health Monitor, Oracle Trace File Analyzer Collector, Oracle Cluster Health Advisor, Memory Guard, and Hang Manager.","category":"Get Started","pdf":"atnms/autonomous-health-framework-users-guide.pdf","html":"atnms/index.html","position":1},{"title":"High Availability Overview and Best Practices","description":"Presents Oracle best practices for deploying a highly available environment, helps you determine your availability requirements, and describes the database architectures that can help your business achieve high availability.","category":"Get Started","pdf":"haovw/high-availability-overview-and-best-practices.pdf","html":"haovw/index.html","position":2},{"title":"High Availability Reference Architectures","html":"haiad/index.html","category":"Get Started","position":3},{"title":"Oracle Maximum Availability Architecture Video Series","html":"//www.youtube.com/playlist?list=PLcFwxJMrxygAutUzBPyPTA_voHObOo-jk","category":"Get Started","position":4},{"title":"Real Applications Clusters Interactive Technical Architecture Diagram","html":"//www.oracle.com/webfolder/technetwork/tutorials/architecture-diagrams/19/rac/main.html","category":"Get Started","position":5},{"title":"Database Backup and Recovery Reference","description":"Provides detailed descriptions of the Recovery Manager (RMAN) commands and recovery catalog views.","category":"Backup and Recovery","pdf":"rcmrf/database-backup-and-recovery-reference.pdf","html":"rcmrf/index.html","position":6},{"title":"Database Backup and Recovery User's Guide","description":"Explains how to use Recovery Manager (RMAN) to back up, recover, and duplicate a database, and how to use Oracle Flashback Technology to restore all or a portion of your data to a previous state.","category":"Backup and Recovery","pdf":"bradv/database-backup-and-recovery-users-guide.pdf","html":"bradv/index.html","position":7},{"title":"Automatic Storage Management Administrator's Guide","description":"Describes how to administer Oracle Automatic Storage Management (Oracle ASM) and Oracle Automatic Storage Management Cluster File System (Oracle ACFS) for Oracle Database.","category":"Clustering","pdf":"ostmg/automatic-storage-management-administrators-guide.pdf","html":"ostmg/index.html","position":8},{"title":"Clusterware Administration and Deployment Guide","description":"The Oracle Clusterware Administration and Deployment Guide describes the Oracle Clusterware architecture and provides an overview of this product. This book also describes administrative and deployment topics for Oracle Clusterware.","category":"Clustering","pdf":"cwadd/clusterware-administration-and-deployment-guide.pdf","html":"cwadd/index.html","position":9},{"title":"Real Application Clusters Administration and Deployment Guide","description":"Describes the Oracle Real Application Clusters (Oracle RAC) architecture and provides an overview of this product, including Oracle Real Application Clusters One Node (Oracle RAC One Node).","category":"Clustering","pdf":"racad/real-application-clusters-administration-and-deployment-guide.pdf","html":"racad/index.html","position":10},{"title":"Data Guard Broker","description":"Describes the Oracle Data Guard broker, a management and monitoring interface that automates many of the tasks involved in configuring and monitoring standby databases in an Oracle Data Guard configuration.","category":"Data Guard","pdf":"dgbkr/data-guard-broker.pdf","html":"dgbkr/index.html","position":11},{"title":"Data Guard Concepts and Administration","description":"Provides a comprehensive overview of Oracle Data Guard concepts and describes how to configure and implement standby databases that can take over production operations if your production database becomes unusable. This guide includes several database scenarios such as creating, recovering, failing over, switching over, configuring, and backing up standby and primary databases.","category":"Data Guard","pdf":"sbydb/data-guard-concepts-and-administration.pdf","html":"sbydb/index.html","position":12},{"title":"Global Data Services Concepts and Administration Guide","description":"Provides dynamic load balancing, failover, and centralized service management for a set of replicated databases that offer common services.","category":"Global Data Services","pdf":"gsmug/global-data-services-concepts-and-administration-guide.pdf","html":"gsmug/index.html","position":13},{"title":"Oracle Globally Distributed Database Guide","description":"Create, deploy, and manage a sharded database using Oracle Sharding","category":"Oracle Sharding","pdf":"shard/oracle-globally-distributed-database-guide.pdf","html":"shard/index.html","position":14}]}