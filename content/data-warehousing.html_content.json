,"pdf":"dwhsg/database-data-warehousing-guide.pdf","html":"dwhsg/index.html","position":1},{"title":"Database Performance Tuning Guide","description":"Provides information about how to tune the performance of Oracle Database using Oracle performance tools.","category":"Essentials","pdf":"tgdba/database-performance-tuning-guide.pdf","html":"tgdba/index.html","position":2},{"title":"SQL Tuning Guide","description":"Describes how to perform SQL tuning, which is the iterative process of improving SQL statement performance to meet specific, measurable, and achievable goals.","category":"Essentials","pdf":"tgsql/sql-tuning-guide.pdf","html":"tgsql/index.html","position":3},{"title":"VLDB and Partitioning Guide","description":"Contains an overview of very large database (VLDB) topics, with emphasis on partitioning and parallel execution as a key component of the VLDB strategy.","category":"Essentials","pdf":"vldbg/vldb-and-partitioning-guide.pdf","html":"vldbg/index.html","position":4},{"title":"Oracle Machine Learning Books","html":"/en/database/oracle/machine-learning/","category":"Machine Learning","position":5},{"title":"OLAP DML Reference","description":"Contains a complete description of the OLAP Data Manipulation Language (OLAP DML) used to define and manipulate analytic workspace objects.","category":"Online Analytical Processing (OLAP)","pdf":"oladm/olap-dml-reference.pdf","html":"oladm/index.html","position":6},{"title":"OLAP Expression Syntax Reference","description":"Describes the Oracle OLAP expression syntax used to generate information-rich content from the data stored in dimensional database objects such as cubes and cube dimensions.","category":"Online Analytical Processing (OLAP)","pdf":"olaxs/olap-expression-syntax-reference.pdf","html":"olaxs/index.html","position":7},{"title":"OLAP Java API Developer's Guide","description":"Provides guidance for developing client applications using the Oracle OLAP Java API.","category":"Online Analytical Processing (OLAP)","pdf":"olaap/olap-java-api-developers-guide.pdf","html":"olaap/index.html","position":8},{"title":"OLAP User's Guide","description":"Explains how SQL applications can extend their analytic processing capabilities and manage summary data by using the OLAP option of Oracle Database.","category":"Online Analytical Processing (OLAP)","pdf":"olaug/olap-users-guide.pdf","html":"olaug/index.html","position":9},{"title":"Oracle OLAP Java API Reference","description":"Provides reference information for the Oracle OLAP Java API.","category":"Online Analytical Processing (OLAP)","html":"olapi/index.html","position":10}]}